<?xml version="1.0" encoding="UTF-8"?>
<manifest>

    <remote
        name="gh"
        fetch="https://github.com/"
        sync-c="true"
        sync-j="4"
        revision="refs/heads/17" />

    <remote
        name="gl"
        fetch="https://git@gitlab.com/"
        sync-c="true"
        sync-j="4"
        revision="refs/heads/17" />

    <remote
        name="gessh"
        fetch="ssh://git@gitea.com/"
        sync-c="true"
        sync-j="4"
        revision="refs/heads/17" />

    <remote
        name="ge"
        fetch="https://gitea.com/"
        sync-c="true"
        sync-j="4"
        revision="refs/heads/17" />

        <!-- Alch3my Manifest -->
        <project path="android" name="Alch3myOS/android" remote="gh" />

        <!-- Build -->
        <project path="build/make" name="Alch3myOS/build_make" groups="pdk,sysui-studio" remote="gh" >
        <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
        <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
        <linkfile src="core" dest="build/core" />
        <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
        <linkfile src="target" dest="build/target" />
        <linkfile src="tools" dest="build/tools" />
    </project>

        <!-- Soong -->
        <project path="build/soong" name="Alch3myOS/build_soong" groups="pdk,tradefed,sysui-studio" remote="gh" >
        <linkfile src="root.bp" dest="Android.bp" />
        <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
    </project>

        <!-- Recovery -->
        <project path="bootable/recovery" name="Alch3myOS/bootable_recovery" groups="pdk" remote="gh" />

        <!-- Sepolicy -->
        <project path="device/lineage/sepolicy" name="Alch3myOS/device_lineage_sepolicy" remote="gh" />

        <!-- Frameworks -->
        <project path="frameworks/base" name="Alch3myOS/frameworks_base" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="gessh" />
        <project path="frameworks/native" name="Alch3myOS/frameworks_native" groups="pdk" remote="gl" />

        <!-- Packages -->
        <project path="packages/apps/ArcaniumUI" name="Alch3myOS/packages_apps_ArcaniumUI" remote="gessh" />
        <project path="packages/apps/AppLocker" name="Alch3myOS/packages_apps_AppLocker" remote="gh" />
        <project path="packages/apps/GameSpace" name="Alch3myOS/packages_apps_GameSpace" remote="gh" />
        <project path="packages/apps/MatLog" name="Alch3myOS/packages_apps_MatLog" remote="gh" />
        <project path="packages/apps/Sandbox" name="Alch3myOS/packages_apps_Sandbox" remote="gh" />
        <!--<project path="packages/apps/Launcher3" name="Alch3myOS/packages_apps_Launcher3" groups="pdk-fs,sysui-studio,pdk-cw-tvc" remote="gh" />-->
        <project path="packages/apps/LineageParts" name="Alch3myOS/packages_apps_LineageParts" remote="gh" />
        <project path="packages/apps/Settings" name="Alch3myOS/packages_apps_Settings" groups="pdk-fs,pdk-cw-tvc,sysui-studio" remote="gessh" />
        <project path="packages/apps/Updater" name="Alch3myOS/packages_apps_Updater" remote="gh" />

        <!-- System -->
        <project path="system/core" name="Alch3myOS/system_core" groups="pdk" remote="gh" />

        <!-- Vendor -->
        <project path="vendor/google/camera" name="Alch3myOS/vendor_google_camera" remote="ge" />
        <project path="vendor/google/CarrierSettings" name="Alch3myOS/vendor_google_CarrierSettings" remote="gh" />
        <project path="vendor/google/faceunlock" name="Alch3myOS/vendor_google_faceunlock" remote="gh" />
        <project path="vendor/extras" name="Alch3myOS/vendor_extras" remote="gl" />
        <project path="vendor/alch3my" name="Alch3myOS/vendor_alch3my" remote="gh" />
        <!--<project path="vendor/gms" name="Alch3myOS/vendor_gms" remote="gessh" />-->
        <project path="vendor/OTA" name="Alch3myOS/OTA" remote="gh" />

</manifest>
